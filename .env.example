# Copy these names into each GitHub Environment secret named ENV_FILE.
# Use different real values for preprod and production; never commit them.
POSTGRES_DB=coliclic
POSTGRES_USER=coliclic
POSTGRES_PASSWORD=change-me

DB_HOST=postgres
DB_PORT=5432
DB_NAME=coliclic
DB_USERNAME=coliclic
DB_PASSWORD=change-me

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=86400000

MAIL_HOST=smtp.example.invalid
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_SUPPORT_EMAIL=support@example.invalid

FRONTEND_BASE_URL=https://example.invalid
REVIEW_BASE_URL=https://example.invalid/traveler-review
CORS_ALLOWED_ORIGINS=https://example.invalid
PASSWORD_RESET_BASE_URL=https://example.invalid/reset-password

GOOGLE_CLIENT_ID=
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
UPLOAD_DIR=/app/uploads
