# Reference for .env.local. Set local URLs, mail settings, and credentials before starting Compose.
# For the GitHub Environment secret ENV_FILE, see .env.preprod.example or .env.prod.example.
POSTGRES_DB=coliclic
POSTGRES_USER=coliclic
POSTGRES_PASSWORD=change-me

DB_HOST=postgres
DB_PORT=5432

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRATION_MS=2592000000
AUTH_COOKIE_NAME=COLICLIC_AUTH
# Keep false for local HTTP. Deployment Compose files force true behind HTTPS.
AUTH_COOKIE_SECURE=false

# FREE: no Coliclic fee or managed payment. COMMISSION: 7% platform fee.
APP_COMMERCIAL_MODE=FREE

# Cloudflare Turnstile pour /contact (voir deploy/README.md)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

MAIL_HOST=smtp.example.invalid
MAIL_PORT=587
MAIL_USERNAME=replace-me
MAIL_PASSWORD=replace-me
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
MAIL_FROM_ADDRESS=noreply@example.invalid
MAIL_SUPPORT_EMAIL=support@example.invalid

FRONTEND_BASE_URL=https://example.invalid
REVIEW_BASE_URL=https://example.invalid/traveler-review
CORS_ALLOWED_ORIGINS=https://example.invalid
PASSWORD_RESET_BASE_URL=https://example.invalid/reset-password
LOGIN_RATE_LIMIT_EMAIL=10
LOGIN_RATE_LIMIT_IP=30
LOGIN_RATE_LIMIT_WINDOW=15m
PASSWORD_RESET_RATE_LIMIT_EMAIL=3
PASSWORD_RESET_RATE_LIMIT_IP=10
PASSWORD_RESET_RATE_LIMIT_WINDOW=60m

GOOGLE_CLIENT_ID=
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
UPLOAD_DIR=/app/uploads

# Database aliases used when the corresponding POSTGRES_* variables are unset.
DB_NAME
DB_USERNAME
DB_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD
REDIS_CONNECT_TIMEOUT=1s
REDIS_TIMEOUT=1s

# Back-office
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE
MESSAGE_EMAIL_NOTIFICATION_COOLDOWN=10m
CONTACT_RATE_LIMIT_EMAIL=3
CONTACT_RATE_LIMIT_IP=10
CONTACT_RATE_LIMIT_WINDOW=15m
PASSWORD_RESET_EXPIRATION_MINUTES=60
GA_MEASUREMENT_ID

# Front-office. The SSR API URL is for the Node server started on the host.
NODE_ENV=development
CHOKIDAR_USEPOLLING=true
PORT=4000
SSR_API_BASE_URL=http://localhost:8080/api
# The preprod Compose file supplies its own report-only policy.
SSR_CSP_REPORT_ONLY

# Only used by the preprod Logback profile. Compose provides the deployed defaults.
LOG_DIR
LOG_MAX_FILE_SIZE
LOG_MAX_HISTORY
LOG_TOTAL_SIZE_CAP
