<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Common pattern for all appenders -->
    <property name="LOG_PATTERN" value="%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level [%thread] %logger{36} - %msg%n"/>

    <!-- File logging defaults can be reused by any environment-specific profile. -->
    <springProperty scope="context" name="LOG_DIR" source="LOG_DIR" defaultValue="logs"/>
    <springProperty scope="context" name="LOG_MAX_FILE_SIZE" source="LOG_MAX_FILE_SIZE" defaultValue="20MB"/>
    <springProperty scope="context" name="LOG_MAX_HISTORY" source="LOG_MAX_HISTORY" defaultValue="7"/>
    <springProperty scope="context" name="LOG_TOTAL_SIZE_CAP" source="LOG_TOTAL_SIZE_CAP" defaultValue="200MB"/>

    <!-- Console appender (always active) -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- Dev profile: file appender + debug logging -->
    <springProfile name="dev | default">

        <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>logs/dev.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>logs/dev.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>10MB</maxFileSize>
                <maxHistory>7</maxHistory>
                <totalSizeCap>100MB</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <!-- Application package at DEBUG level -->
        <logger name="com.coliclic" level="DEBUG"/>

        <!-- Hibernate SQL queries at DEBUG level -->
        <logger name="org.hibernate.SQL" level="DEBUG"/>
        <logger name="org.hibernate.orm.jdbc.bind" level="TRACE"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="FILE"/>
        </root>

    </springProfile>

    <!-- Preprod profile: readable console logs and seven days of persistent files. -->
    <springProfile name="preprod">

        <appender name="PREPROD_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
            <file>${LOG_DIR}/preprod.log</file>
            <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                <fileNamePattern>${LOG_DIR}/preprod.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                <maxFileSize>${LOG_MAX_FILE_SIZE}</maxFileSize>
                <maxHistory>${LOG_MAX_HISTORY}</maxHistory>
                <totalSizeCap>${LOG_TOTAL_SIZE_CAP}</totalSizeCap>
            </rollingPolicy>
            <encoder>
                <pattern>${LOG_PATTERN}</pattern>
            </encoder>
        </appender>

        <logger name="com.coliclic" level="INFO"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
            <appender-ref ref="PREPROD_FILE"/>
        </root>

    </springProfile>

    <!-- Other non-dev profiles remain console-only until explicitly enabled. -->
    <springProfile name="!dev &amp; !default &amp; !preprod">

        <logger name="com.coliclic" level="INFO"/>

        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>

    </springProfile>

</configuration>
