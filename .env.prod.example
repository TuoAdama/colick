# Reference for the production GitHub Environment secret ENV_FILE.
# Fill in stage-specific settings privately. Keep credentials out of version control.
# Lines with a name alone leave the setting unset until a value is supplied.

# PostgreSQL
POSTGRES_DB
POSTGRES_USER
POSTGRES_PASSWORD
DB_HOST=postgres
DB_PORT=5432
# Optional aliases if the corresponding POSTGRES_* variables are unset.
DB_NAME
DB_USERNAME
DB_PASSWORD

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD
REDIS_CONNECT_TIMEOUT=1s
REDIS_TIMEOUT=1s

# Back-office
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE
UPLOAD_DIR=/app/uploads
APP_COMMERCIAL_MODE=FREE
FRONTEND_BASE_URL=https://coliclic.com
REVIEW_BASE_URL=https://coliclic.com/traveler-review
CORS_ALLOWED_ORIGINS=https://coliclic.com

# Authentication
JWT_SECRET
JWT_EXPIRATION_MS=2592000000
AUTH_COOKIE_NAME=COLICLIC_AUTH
AUTH_COOKIE_SECURE=true
GOOGLE_CLIENT_ID
LOGIN_RATE_LIMIT_EMAIL=10
LOGIN_RATE_LIMIT_IP=30
LOGIN_RATE_LIMIT_WINDOW=15m
PASSWORD_RESET_BASE_URL=https://coliclic.com/reset-password
PASSWORD_RESET_EXPIRATION_MINUTES=60
PASSWORD_RESET_RATE_LIMIT_EMAIL=3
PASSWORD_RESET_RATE_LIMIT_IP=10
PASSWORD_RESET_RATE_LIMIT_WINDOW=60m

# Email, SMS and analytics
MAIL_HOST
MAIL_PORT
MAIL_USERNAME
MAIL_PASSWORD
MAIL_SMTP_AUTH
MAIL_SMTP_STARTTLS_ENABLE
MAIL_FROM_ADDRESS
MAIL_SUPPORT_EMAIL
MESSAGE_EMAIL_NOTIFICATION_COOLDOWN=10m
CONTACT_RATE_LIMIT_EMAIL=3
CONTACT_RATE_LIMIT_IP=10
CONTACT_RATE_LIMIT_WINDOW=15m
SMS_ENABLED=false
TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN
TWILIO_FROM_NUMBER
GA_MEASUREMENT_ID

# Front-office. The Docker image and Compose supply the deployed settings.
NODE_ENV=production
CHOKIDAR_USEPOLLING
PORT=4000
SSR_API_BASE_URL=http://back-office:8080/api
# The preprod Compose file supplies its own report-only policy.
SSR_CSP_REPORT_ONLY

# Only used in preprod. The LOG_* overrides are read from .release.env by Compose.
LOG_DIR
LOG_MAX_FILE_SIZE
LOG_MAX_HISTORY
LOG_TOTAL_SIZE_CAP
